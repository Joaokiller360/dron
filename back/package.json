{
  "name": "jbskylens-back",
  "version": "0.2.0",
  "description": "JB.SKYLENS backend: NestJS microservices (gateway, auth, content, store, media, events) + Prisma + PostgreSQL",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "build": "nest build gateway && nest build auth && nest build content && nest build store && nest build media && nest build events",
    "build:gateway": "nest build gateway",
    "build:auth": "nest build auth",
    "build:content": "nest build content",
    "build:store": "nest build store",
    "build:media": "nest build media",
    "build:events": "nest build events",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start:gateway": "nest start gateway --watch",
    "start:auth": "nest start auth --watch",
    "start:content": "nest start content --watch",
    "start:store": "nest start store --watch",
    "start:media": "nest start media --watch",
    "start:events": "nest start events --watch",
    "start:prod": "node dist/apps/$APP/main",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "prisma:generate": "prisma generate --schema apps/auth/prisma/schema.prisma && prisma generate --schema apps/content/prisma/schema.prisma && prisma generate --schema apps/store/prisma/schema.prisma",
    "prisma:migrate:auth": "prisma migrate deploy --schema apps/auth/prisma/schema.prisma",
    "prisma:migrate:content": "prisma migrate deploy --schema apps/content/prisma/schema.prisma",
    "prisma:migrate:store": "prisma migrate deploy --schema apps/store/prisma/schema.prisma",
    "prisma:seed": "ts-node apps/auth/prisma/seed.ts && ts-node apps/content/prisma/seed-content.ts",
    "admin:password": "node apps/auth/prisma/set-admin-password.js",
    "jwt:keys": "node scripts/generate-jwt-keys.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@aws-sdk/s3-presigned-post": "^3.1138.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^5.2.0",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^7.2.0",
    "nest-winston": "^1.9.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.9",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/apps",
      "<rootDir>/libs",
      "<rootDir>/db"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src$1"
    },
    "collectCoverageFrom": [
      "{apps,libs}/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}
