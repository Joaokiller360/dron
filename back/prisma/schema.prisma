generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContactStatus {
  NEW
  READ
  ARCHIVED
}

enum CategoryType {
  PROJECT
  CLIENT
  SERVICE
}

model Category {
  id        String       @id @default(uuid())
  slug      String
  name      String
  type      CategoryType
  sortOrder Int          @default(0) @map("sort_order")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  projects Project[]
  clients  Client[]
  services Service[]

  @@unique([type, slug])
  @@map("categories")
  @@index([type])
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}

model ContactMessage {
  id        String        @id @default(uuid())
  name      String
  phone     String
  email     String
  message   String
  locale    String        @default("es")
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@map("contact_messages")
  @@index([status])
}

model Project {
  id             String    @id @default(uuid())
  slug           String    @unique
  categoryId     String    @map("category_id")
  category       Category  @relation(fields: [categoryId], references: [id])
  titleEs        String    @map("title_es")
  titleEn        String?   @map("title_en")
  descriptionEs  String?   @map("description_es")
  descriptionEn  String?   @map("description_en")
  coverUrl       String    @map("cover_url")
  href           String?
  mediaUrls      String[]  @default([]) @map("media_urls")
  published      Boolean   @default(true)
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("projects")
  @@index([categoryId])
  @@index([published])
}

model TeamMember {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  role      String
  photoUrl  String   @map("photo_url")
  links     Json     @default("[]")
  published Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("team_members")
  @@index([published])
}

model Client {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  categoryId   String   @map("category_id")
  category     Category @relation(fields: [categoryId], references: [id])
  photoUrl     String   @map("photo_url")
  links        Json     @default("[]")
  published    Boolean  @default(true)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("clients")
  @@index([categoryId])
  @@index([published])
}

model Service {
  id            String   @id @default(uuid())
  slug          String   @unique
  titleEs       String   @map("title_es")
  titleEn       String?  @map("title_en")
  descriptionEs String?  @map("description_es")
  descriptionEn String?  @map("description_en")
  coverUrl      String   @map("cover_url")
  href          String?
  categoryId    String   @map("category_id")
  category      Category @relation(fields: [categoryId], references: [id])
  published     Boolean  @default(true)
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("services")
  @@index([categoryId])
  @@index([published])
}
