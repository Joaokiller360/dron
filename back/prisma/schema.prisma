generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContactStatus {
  NEW
  READ
  ARCHIVED
}

enum CategoryType {
  PROJECT
  CLIENT
  SERVICE
}

model Category {
  id        String       @id @default(uuid())
  slug      String
  name      String
  type      CategoryType
  sortOrder Int          @default(0) @map("sort_order")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  projects Project[]
  clients  Client[]
  services Service[]

  @@unique([type, slug])
  @@index([type])
  @@map("categories")
}

model AdminUser {
  id                String         @id @default(uuid())
  email             String         @unique
  passwordHash      String         @map("password_hash")
  // Sessions (JWTs) issued before this moment are rejected
  passwordChangedAt DateTime?      @map("password_changed_at")
  name              String
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  refreshTokens     RefreshToken[]

  @@map("admin_users")
}

// Long-lived half of a dashboard session. Only a SHA-256 of the token is kept;
// each refresh revokes the used row and issues the next one in its family, and
// presenting a revoked token revokes the whole family (stolen-token reuse).
model RefreshToken {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  user             AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash        String    @unique @map("token_hash")
  familyId         String    @map("family_id")
  expiresAt        DateTime  @map("expires_at")
  // Hard limit for the whole family: refreshing never extends past it
  sessionExpiresAt DateTime  @map("session_expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model ContactMessage {
  id        String        @id @default(uuid())
  name      String
  phone     String
  email     String
  message   String
  locale    String        @default("es")
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([status])
  @@map("contact_messages")
}

model Project {
  id            String   @id @default(uuid())
  slug          String   @unique
  categoryId    String   @map("category_id")
  category      Category @relation(fields: [categoryId], references: [id])
  titleEs       String   @map("title_es")
  titleEn       String?  @map("title_en")
  descriptionEs String?  @map("description_es")
  descriptionEn String?  @map("description_en")
  coverUrl      String   @map("cover_url")
  href          String?
  mediaUrls     String[] @default([]) @map("media_urls")
  published     Boolean  @default(true)
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([published])
  @@map("projects")
}

model TeamMember {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  role      String
  photoUrl  String   @map("photo_url")
  bio       String?
  story     String?
  stat      String?
  statLabel String?  @map("stat_label")
  base      String?
  skills    String[] @default([])
  links     Json     @default("[]")
  published Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([published])
  @@map("team_members")
}

model Client {
  id         String   @id @default(uuid())
  slug       String   @unique
  name       String
  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id])
  photoUrl   String   @map("photo_url")
  links      Json     @default("[]")
  published  Boolean  @default(true)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  testimonials Testimonial[]

  @@index([categoryId])
  @@index([published])
  @@map("clients")
}

model Service {
  id            String    @id @default(uuid())
  slug          String    @unique
  titleEs       String    @map("title_es")
  titleEn       String?   @map("title_en")
  descriptionEs String?   @map("description_es")
  descriptionEn String?   @map("description_en")
  coverUrl      String    @map("cover_url")
  href          String?
  categoryId    String?   @map("category_id")
  category      Category? @relation(fields: [categoryId], references: [id])
  published     Boolean   @default(true)
  sortOrder     Int       @default(0) @map("sort_order")

  // Full service page (like /services/film-and-tv-production). When isPage is
  // true the public site renders a rich page at /services/<slug> from `page`,
  // which holds the whole PageServices prop tree (D, Content, keyword,
  // keywordLink, galery, P, CalltoAction, Animations, Example).
  isPage          Boolean  @default(false) @map("is_page")
  page            Json?
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description")
  keywords        String[] @default([])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([published])
  @@map("services")
}

model LegalPage {
  id              String   @id @default(uuid())
  slug            String   @unique
  titleEs         String   @map("title_es")
  titleEn         String?  @map("title_en")
  label           String?
  lastUpdate      String?  @map("last_update")
  keywords        String[] @default([])
  // Array of sections: { heading?, text?: string[], lists?: { header?, description?: string[], items: string[] }[] }
  content         Json
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description")
  published       Boolean  @default(true)
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([published])
  @@map("legal_pages")
}

// Seasonal offers shown on the landing (bar, section and badges on services)
model Promotion {
  id            String    @id @default(uuid())
  title         String
  detail        String?
  badge         String?
  untilLabel    String?   @map("until_label")
  price         String?
  oldPrice      String?   @map("old_price")
  // Service whose card gets the badge (Service.slug), optional
  serviceSlug   String?   @map("service_slug")
  // Real discount on store products: PERCENT (1–90) or FIXED (cents off each
  // unit); null = display-only promotion. productIds empty = whole store
  discountType  String?   @map("discount_type")
  discountValue Int?      @map("discount_value")
  productIds    String[]  @default([]) @map("product_ids")
  // Hidden automatically once this date passes
  endsAt        DateTime? @map("ends_at")
  active        Boolean   @default(true)
  sortOrder     Int       @default(0) @map("sort_order")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([active])
  @@map("promotions")
}

// Small key/value store for site-wide switches (e.g. key "promotions")
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

// Client quotes for the clients page ("Lo que dicen")
model Testimonial {
  id        String   @id @default(uuid())
  quote     String
  author    String
  org       String?
  // Own photo of the author; when empty the linked client's photo is shown
  photoUrl  String?  @map("photo_url")
  clientId  String?  @map("client_id")
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  published Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([published])
  @@index([clientId])
  @@map("testimonials")
}

// Places offered in the contact form's "lugar" select (e.g. "Marina Ecovida"),
// grouped by city
model Venue {
  id        String   @id @default(uuid())
  name      String
  city      String
  published Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([city])
  @@index([published])
  @@map("venues")
}

// Online store. Switches (store visible, sales open) live in site_settings
// under key "store".
model Product {
  id             String   @id @default(uuid())
  slug           String   @unique
  nameEs         String   @map("name_es")
  nameEn         String?  @map("name_en")
  descriptionEs  String?  @map("description_es")
  descriptionEn  String?  @map("description_en")
  // Prices in cents (USD) to avoid float rounding
  priceCents     Int      @map("price_cents")
  // Crossed-out "before" price, optional
  compareAtCents Int?     @map("compare_at_cents")
  // null = unlimited stock
  stock          Int?
  coverUrl       String   @map("cover_url")
  // Extra photos shown in the product page gallery
  mediaUrls      String[] @default([]) @map("media_urls")
  // Details table on the product page: { label, value }[] (e.g. Material: aluminio)
  specs          Json     @default("[]")
  // Choices that change the price: { name, values: { label, priceCents }[] }[]
  // (e.g. Medida: 30 × 40 cm +0, 50 × 70 cm +1500). Buyers pick one value per
  // option; unit price = priceCents + the chosen values' priceCents.
  options        Json     @default("[]")
  published      Boolean  @default(true)
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([published])
  @@map("products")
}

enum PaymentMethod {
  PAYPAL
  TRANSFER
}

// PENDING_PAYMENT → PAID (PayPal capture verified) → SHIPPED (carrier + tracking)
// → COMPLETED. Unpaid orders expire to CANCELLED; paid ones end in REFUNDED.
enum OrderStatus {
  PENDING_PAYMENT
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

// Order placed from the store and paid through PayPal
model Order {
  id            String        @id @default(uuid())
  // Short human reference shown to the buyer (e.g. "JB-7K2Q9M")
  code          String        @unique
  name          String
  email         String
  phone         String
  // Delivery address typed at checkout
  address       String
  city          String
  note          String?
  locale        String        @default("es")
  // Snapshot of what was bought: { productId, name, unitCents, quantity }[]
  items         Json
  // Shipping city whose rate was charged (null = store without shipping
  // cities) and what it charged; totalCents = items + shippingCents
  shippingCity  String?       @map("shipping_city")
  shippingCents Int           @default(0) @map("shipping_cents")
  totalCents    Int           @map("total_cents")
  status        OrderStatus   @default(PENDING_PAYMENT)
  paymentMethod PaymentMethod @default(PAYPAL) @map("payment_method")

  // Bank transfer: bank the buyer paid from and the transfer code; the owner
  // checks it against the bank statement and confirms in the dashboard
  transferBank      String? @map("transfer_bank")
  transferReference String? @map("transfer_reference")

  // PayPal: order created at checkout, capture made (and verified) on approval
  paypalOrderId   String?   @unique @map("paypal_order_id")
  paypalCaptureId String?   @unique @map("paypal_capture_id")
  paidAt          DateTime? @map("paid_at")
  refundedAt      DateTime? @map("refunded_at")

  // Shipping, set by the owner in the dashboard
  carrier        String?
  trackingNumber String?   @map("tracking_number")
  trackingUrl    String?   @map("tracking_url")
  shippedAt      DateTime? @map("shipped_at")

  // Buyer emails are sent by a background task; null = still to send (retried)
  paidEmailAt    DateTime? @map("paid_email_at")
  shippedEmailAt DateTime? @map("shipped_email_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([transferReference])
  @@map("orders")
}
