POSTGRES_DB=jbskylens
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_super_user_password

# password for the PostgREST "authenticator" role (set inside schema.sql / 02-set-authenticator-password.sh)
AUTHENTICATOR_PASSWORD=change_me_authenticator_password

# used to verify/issue JWTs so PostgREST can switch into web_contact / web_admin roles
PGRST_JWT_SECRET=change_me_at_least_32_chars_long

# public URL PostgREST reports in its OpenAPI doc, e.g. https://api.jbskylens.dev
PGRST_PUBLIC_URL=http://localhost:3001
