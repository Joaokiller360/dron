# App
NODE_ENV=development
PORT=3001
API_PREFIX=api
# comma-separated list; add your LAN IP (e.g. http://192.168.x.x:3000) if you
# open the front from another device or via network URL instead of localhost
CORS_ORIGIN=http://localhost:3000

# Database (Prisma)
POSTGRES_USER=jbskylens
POSTGRES_PASSWORD=change_me_super_user_password
POSTGRES_DB=jbskylens
POSTGRES_PORT=5432
DATABASE_URL=postgresql://jbskylens:change_me_super_user_password@localhost:5432/jbskylens?schema=public

# JWT
JWT_SECRET=change_me_at_least_32_chars_long
JWT_EXPIRES_IN=1d

# Seed admin user (used by prisma/seed.ts)
ADMIN_EMAIL=admin@joaobarres.dev
ADMIN_PASSWORD=change_me_admin_password

# Logging
LOG_LEVEL=info
